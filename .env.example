# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT AUTHENTICATION CONFIGURATION
JWT_SECRET="your_strong_jwt_secret_key_minimum_32_characters_here"
JWT_EXPIRES_IN="1d"

# SENSITIVE MASTER ADMIN CONFIGURATION (Never hardcode credentials in source code)
MASTER_ADMIN_EMAIL="admin@mosmaster.edu.vn"
MASTER_ADMIN_PASSWORD="your_strong_master_admin_password_here"

# GOOGLE WORKSPACE / SHEETS INTEGRATION
GOOGLE_SHEETS_MASTER_URL="https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# DATABASE CONFIGURATION (PostgreSQL / Relational Database Connection Manager)
VITE_DATABASE_URL="postgresql://mos_admin:secure_password@localhost:5432/mos_master_db?sslmode=prefer"
VITE_DB_HOST="localhost"
VITE_DB_PORT="5432"
VITE_DB_NAME="mos_master_db"
VITE_DB_USER="mos_admin"
VITE_DB_PASSWORD="your_strong_password_here"
VITE_DB_SSL="false"
VITE_DB_POOL_MAX="20"
VITE_DB_IDLE_TIMEOUT_MS="30000"
