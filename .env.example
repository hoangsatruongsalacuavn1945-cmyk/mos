# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (PostgreSQL / Relational Database Connection Manager)
# Database credentials read exclusively from environment variables via import.meta.env
VITE_DATABASE_URL="postgresql://mos_admin:secure_password@localhost:5432/mos_master_db?sslmode=prefer"
VITE_DB_HOST="localhost"
VITE_DB_PORT="5432"
VITE_DB_NAME="mos_master_db"
VITE_DB_USER="mos_admin"
VITE_DB_PASSWORD="your_strong_password_here"
VITE_DB_SSL="false"
VITE_DB_POOL_MAX="20"
VITE_DB_IDLE_TIMEOUT_MS="30000"
